<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GamepadMouse</RootNamespace>
    <AssemblyName>GamepadMouse</AssemblyName>
    <Version>1.3.0</Version>
    <Product>GamepadMouse 手柄映射鼠标</Product>
    <Description>后台托盘程序：将手柄映射为鼠标，组合键开关映射，全部可自定义</Description>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

</Project>
